{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // verbatimModuleSyntax is DELIBERATELY off here, and only here.
    // Verified with tsc 6.0.3: it is mutually exclusive with CommonJS emit
    // (TS1287 "A top-level 'export' modifier cannot be used on value
    // declarations in a CommonJS module", TS1295). The root tsconfig.json is
    // the authoritative pass and keeps it on, so nothing is actually relaxed.
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "rootDir": "../src",
    "outDir": "../lib/cjs",
    "declarationDir": "../lib/cjs/types"
  },
  "include": ["../src/**/*"]
}
