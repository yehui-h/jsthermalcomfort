{
  // The only build. Inherits every strictness flag from the type-check pass and
  // adds emit; `tests` are dropped because `rootDir` is `src`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // The maps resolve because `src` ships in package.json "files" — without
    // it every `sources` entry points outside the tarball and go-to-definition
    // lands nowhere.
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib/esm",
    "declarationDir": "lib/esm/types"
  },
  "include": ["src/**/*"]
}
