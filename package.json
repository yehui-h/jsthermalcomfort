{
  "name": "jsthermalcomfort",
  "version": "1.4.0",
  "description": "A JavaScript package to calculate thermophysiological, thermal comfort, thermal stress indices",
  "type": "module",
  "files": [
    "lib",
    "models",
    "psychrometrics",
    "utilities",
    "reference",
    "io",
    "charts"
  ],
  "main": "./lib/cjs/index.js",
  "types": "./lib/cjs/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf ./lib ./models ./psychrometrics ./utilities ./reference ./io ./charts",
    "typecheck": "tsc -p ./configs/tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:cjs-marker && npm run build:stubs",
    "build:esm": "tsc -p ./configs/tsconfig.esm.json",
    "build:cjs": "tsc -p ./configs/tsconfig.cjs.json",
    "build:cjs-marker": "node -e \"require('fs').writeFileSync('lib/cjs/package.json', JSON.stringify({type:'commonjs'}) + '\\n')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "check:exports": "publint && attw --pack .",
    "format": "prettier . --write",
    "check:format": "prettier . --check",
    "prepack": "npm run build",
    "prepare": "husky",
    "build:stubs": "node scripts/build-subpath-stubs.mjs"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FedericoTartarini/jsthermalcomfort.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "keywords": [
    "thermal comfort",
    "heat stress",
    "predicted mean vote",
    "human thermophysiological modeling"
  ],
  "author": "Federico Tartarini",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FedericoTartarini/jsthermalcomfort/issues"
  },
  "homepage": "https://federicotartarini.github.io/jsthermalcomfort/",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "sideEffects": false,
  "module": "./lib/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./models": {
      "import": {
        "types": "./lib/esm/types/models/index.d.ts",
        "default": "./lib/esm/models/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/models/index.d.ts",
        "default": "./lib/cjs/models/index.js"
      }
    },
    "./psychrometrics": {
      "import": {
        "types": "./lib/esm/types/psychrometrics/index.d.ts",
        "default": "./lib/esm/psychrometrics/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/psychrometrics/index.d.ts",
        "default": "./lib/cjs/psychrometrics/index.js"
      }
    },
    "./utilities": {
      "import": {
        "types": "./lib/esm/types/utilities/index.d.ts",
        "default": "./lib/esm/utilities/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/utilities/index.d.ts",
        "default": "./lib/cjs/utilities/index.js"
      }
    },
    "./reference": {
      "import": {
        "types": "./lib/esm/types/reference/index.d.ts",
        "default": "./lib/esm/reference/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/reference/index.d.ts",
        "default": "./lib/cjs/reference/index.js"
      }
    },
    "./io": {
      "import": {
        "types": "./lib/esm/types/io/index.d.ts",
        "default": "./lib/esm/io/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/io/index.d.ts",
        "default": "./lib/cjs/io/index.js"
      }
    },
    "./charts": {
      "import": {
        "types": "./lib/esm/types/charts/index.d.ts",
        "default": "./lib/esm/charts/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/charts/index.d.ts",
        "default": "./lib/cjs/charts/index.js"
      }
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": "prettier --write"
  }
}
